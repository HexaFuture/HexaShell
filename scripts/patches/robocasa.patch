 from robosuite.utils.mjcf_utils import array_to_string, string_to_array, find_elements
 
 
+def write_temporary_mjcf(xml_str, source_dir):
+    """把派生 MJCF 写到不可变资产树之外。
+
+    ``MujocoXML`` 会从派生 XML 所在目录解析相对资产路径，因此写入进程临时
+    目录前，必须先以原模型目录为基准把全部文件依赖改为绝对路径。
+    """
+
+    root = ET.fromstring(xml_str)
+    asset = root.find("asset")
+    if asset is not None:
+        for node in asset.findall("./*[@file]"):
+            file_path = node.get("file")
+            if file_path and not os.path.isabs(file_path):
+                node.set("file", os.path.normpath(os.path.join(source_dir, file_path)))
+    descriptor, path = tempfile.mkstemp(
+        prefix=f"robocasa-{os.getpid()}-",
+        suffix=".xml",
+    )
+    try:
+        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
+            stream.write(ET.tostring(root, encoding="unicode"))
+    except BaseException:
+        if os.path.exists(path):
+            os.remove(path)
+        raise
+    return path
+
